# Copy this file to .env and fill in your values. NEVER commit .env.
ECOURTS_URL=https://filing.ecourts.gov.in/pdedev/
ECOURTS_STATE=Telangana
ECOURTS_MOBILE=
ECOURTS_PASSWORD=

# Text of the option to pick at the top after login.
ECOURTS_COURT_OPTION=District Court

# Captcha: auto (OCR, then ask you if running in a terminal), ocr, or manual
CAPTCHA_MODE=auto
LOGIN_ATTEMPTS=3

# Daily sync time (24h, in TIMEZONE)
SYNC_HOUR=19
SYNC_MINUTE=0
TIMEZONE=Asia/Kolkata

# What happens to a date you changed by hand when the portal later shows a NEW date:
#   reset = portal's new date wins (your manual date is kept in history)
#   keep  = your manual date always wins until you clear it
MANUAL_OVERRIDE_POLICY=reset

# Browser: set HEADLESS=false to watch the browser while it logs in
HEADLESS=true

# Web UI
APP_HOST=127.0.0.1
APP_PORT=5000
# Optional: protect the web UI with a password (username is "admin")
APP_PASSWORD=
